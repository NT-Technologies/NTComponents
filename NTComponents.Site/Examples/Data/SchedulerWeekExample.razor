@using NTComponents.Scheduler

<NTScheduler TEventType="NTEvent"
             Events="_events"
             View="NTSchedulerView.Week"
             StartViewOn="DayOfWeek.Monday"
             HourRowHeight="48"
             AriaLabel="Team calendar"
             class="docs-fill"
             style="block-size: 36rem;" />

@code {
    private readonly List<NTEvent> _events = CreateEvents();

    private static List<NTEvent> CreateEvents() {
        var monday = DateTime.Today.AddDays(-(((int)DateTime.Today.DayOfWeek + 6) % 7));
        DateTimeOffset At(int day, int hour, int minute = 0) => new(monday.AddDays(day).AddHours(hour).AddMinutes(minute));
        return [
            new NTEvent { Title = "Sprint planning", EventStart = At(0, 9), EventEnd = At(0, 10, 30) },
            new NTEvent { Title = "Design review", EventStart = At(1, 13), EventEnd = At(1, 14) },
            new NTEvent { Title = "1:1 with Grace", EventStart = At(2, 11), EventEnd = At(2, 11, 30) },
            new NTEvent { Title = "Release freeze", EventStart = At(3, 0), EventEnd = At(4, 0), IsAllDay = true },
            new NTEvent { Title = "Demo day", EventStart = At(4, 15), EventEnd = At(4, 16, 30) }
        ];
    }
}
