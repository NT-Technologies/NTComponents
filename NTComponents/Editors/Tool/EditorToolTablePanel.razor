@namespace NTComponents
@using Microsoft.AspNetCore.Components

<div class="nt-rich-text-editor-inline-tool nt-rich-text-editor-table-editor"
     popover="manual"
     data-tool-command="table"
     data-role="table-editor"
     role="group"
     aria-label="Table settings"
     hidden
     aria-hidden="true">
    <div class="nt-rich-text-editor-table-insert" data-role="table-insert">
        <div class="nt-rich-text-editor-table-grid" data-role="table-grid" role="group" aria-label="Table size">
            @for (var row = 1; row <= 10; row++) {
                for (var column = 1; column <= 8; column++) {
                    <button type="button"
                            tabindex="@(row == 1 && column == 1 ? "0" : "-1")"
                            disabled="@Disabled"
                            data-col="@column"
                            data-row="@row"
                            aria-label="Insert @column by @row table"></button>
                }
            }
        </div>
        <span class="nt-rich-text-editor-table-grid-label" data-role="table-grid-label" aria-live="polite">Insert table</span>
    </div>
    <div class="nt-rich-text-editor-table-edit" data-role="table-edit" hidden>
        <div class="nt-rich-text-editor-inline-tool-fields">
            <NTInputColor Label="Border color"
                          @bind-Value="_tableBorderColor"
                          Appearance="NTFormAppearance.Outlined"
                          Density="NTFormDensity.Standard"
                          Disabled="@Disabled"
                          SubmitValue="false"
                          data-role="table-border-color" />
            <NTInputText Label="Caption"
                         @bind-Value="_tableCaption"
                         Appearance="NTFormAppearance.Outlined"
                         Density="NTFormDensity.Standard"
                         Placeholder="Optional table caption"
                         Disabled="@Disabled"
                         SubmitValue="false"
                         data-role="table-caption" />
        </div>
        <div class="nt-rich-text-editor-inline-tool-actions">
            <NTButton Label="Apply table"
                      ButtonSize="NTSize.Small"
                      Disabled="@Disabled"
                      Type="ButtonType.Button"
                      data-role="table-apply" />
            <NTButton Label="Cancel"
                      ButtonSize="NTSize.Small"
                      Disabled="@Disabled"
                      Type="ButtonType.Button"
                      Variant="NTButtonVariant.Text"
                      data-role="table-cancel" />
        </div>
    </div>
</div>

<NTContextMenu TargetElementId="@SurfaceId"
               TargetSelector="td, th"
               AriaLabel="Table actions"
               Disabled="@(Disabled || string.IsNullOrWhiteSpace(SurfaceId))">
    <MenuContent>
        <NTMenuButtonItem Label="Insert row above" data-table-action="row-above" />
        <NTMenuButtonItem Label="Insert row below" data-table-action="row-below" />
        <NTMenuButtonItem Label="Insert column left" data-table-action="column-left" />
        <NTMenuButtonItem Label="Insert column right" data-table-action="column-right" />
        <NTMenuDividerItem />
        <NTMenuButtonItem Label="Delete row" data-table-action="delete-row" />
        <NTMenuButtonItem Label="Delete column" data-table-action="delete-column" />
        <NTMenuButtonItem Label="Delete table" data-table-action="delete-table" />
    </MenuContent>
</NTContextMenu>

@code {
    private string? _tableBorderColor;
    private string? _tableCaption;

    [Parameter]
    public bool Disabled { get; set; }

    [CascadingParameter(Name = "RichTextEditorSurfaceId")]
    public string? SurfaceId { get; set; }
}
