@namespace NTComponents
@typeparam DateTimeType
@inherits NTInputBase<DateTimeType>

<NTPageScript Src="@JsModulePath" />

<div class="@RootClass">
    @base.BuildRenderTree

    @if (EnableCustomPicker) {
        <button type="button"
                class="nt-dtp-trigger"
                aria-label="@_metadata.PickerTriggerAriaLabel"
                data-nt-dtp-trigger="true"
                data-nt-dtp-target="@_pickerId"
                tabindex="-1"
                disabled="@IsPickerTriggerDisabled">
            @(_resolvedPickerTriggerIcon.Render("nt-dtp-trigger-icon"))
        </button>

        <div id="@_pickerId"
             class="@_pickerClass"
             role="dialog"
             aria-modal="false"
             aria-hidden="true"
             aria-labelledby="@_pickerHeadlineId"
             tabindex="-1"
             data-nt-dtp-picker="true"
             data-nt-dtp-mode="@_metadata.PickerMode">
            <div class="nt-dtp-surface" data-nt-dtp-surface>
                <div class="nt-dtp-header">
                    <div class="nt-dtp-subhead" data-nt-dtp-subhead>@_metadata.PickerSupportingLabel</div>
                    <div class="nt-dtp-headline" id="@_pickerHeadlineId" data-nt-dtp-headline>@_metadata.PickerHeadline</div>
                </div>

                <div class="nt-dtp-content" data-nt-dtp-content></div>

                <div class="nt-dtp-actions">
                    <div class="nt-dtp-action-group">
                        <button type="button" class="nt-dtp-action-button nt-dtp-text-button" data-nt-dtp-action="cancel">Cancel</button>
                        <button type="button" class="nt-dtp-action-button nt-dtp-text-button" data-nt-dtp-action="confirm">OK</button>
                    </div>
                </div>
            </div>
        </div>
    }
    else {
        <button type="button"
                class="nt-dtp-trigger nt-dtp-native-trigger"
                aria-label="@_metadata.PickerTriggerAriaLabel"
                data-nt-dtp-native-trigger="true"
                tabindex="-1"
                disabled="@IsPickerTriggerDisabled">
            @(_resolvedPickerTriggerIcon.Render("nt-dtp-trigger-icon"))
        </button>
    }
</div>
