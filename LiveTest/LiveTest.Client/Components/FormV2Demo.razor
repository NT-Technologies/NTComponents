            </NTFormSectionView>

            <NTFormSectionView Heading="Span presets" Description="Preset items keep the same field component API and only change layout width." MaxColumns="4">
                <NTFormFieldLayoutSpan Span="NTFormFieldSpan.Auto">
                    <NTInputText @bind-Value="_layoutAuto" Label="Auto" SupportingText="Parent default span" />
                </NTFormFieldLayoutSpan>

                <NTFormFieldLayoutSpan Span="NTFormFieldSpan.Compact">
                    <NTInputText @bind-Value="_layoutCompact" Label="Compact" SupportingText="Short values" />
                </NTFormFieldLayoutSpan>

                <NTFormFieldLayoutSpan Span="NTFormFieldSpan.OneQuarter">
                    <NTInputText @bind-Value="_layoutQuarter" Label="Quarter" SupportingText="One quarter" />
                </NTFormFieldLayoutSpan>

                <NTFormFieldLayoutSpan Span="NTFormFieldSpan.OneThird">
                    <NTInputText @bind-Value="_layoutThird" Label="Third" SupportingText="One third" />
                </NTFormFieldLayoutSpan>

                <NTFormFieldLayoutSpan Span="NTFormFieldSpan.Half">
                    <NTInputText @bind-Value="_layoutHalf" Label="Half" SupportingText="Half row" />
                </NTFormFieldLayoutSpan>

                <NTFormFieldLayoutSpan Span="NTFormFieldSpan.TwoThirds">
                    <NTInputText @bind-Value="_layoutTwoThirds" Label="Two thirds" SupportingText="Wide field" />
                </NTFormFieldLayoutSpan>

                <NTFormFieldLayoutSpan Span="NTFormFieldSpan.ThreeQuarters">
                    <NTInputText @bind-Value="_layoutThreeQuarters" Label="Three quarters" SupportingText="Wider field" />
                </NTFormFieldLayoutSpan>

                <NTFormFieldLayoutSpan Span="NTFormFieldSpan.Full">
                    <NTTextArea @bind-Value="_layoutFull" Label="Full" SupportingText="Full-width content" MinVisibleLines="2" />
                </NTFormFieldLayoutSpan>

                <NTFormFieldLayoutSpan SmallColumns="12" MediumColumns="5" LargeColumns="7">
                    <NTInputText @bind-Value="_layoutExplicit" Label="Explicit 12 / 5 / 7" SupportingText="Column override" />
                </NTFormFieldLayoutSpan>
            </NTFormSectionView>

            <NTFormSectionView Heading="Fieldset group" Description="Use fieldset semantics when multiple controls answer one grouped question." UseFieldset="true" MaxColumns="2">
                <NTInputRadioGroup TValue="string" @bind-Value="_layoutChoice" Label="Grouped choice">
                    <NTInputRadio TValue="string" Value="@("email")" Label="Email" />
                    <NTInputRadio TValue="string" Value="@("sms")" Label="SMS" />
                    <NTInputRadio TValue="string" Value="@("phone")" Label="Phone" />
                </NTInputRadioGroup>

                <NTInputSwitch @bind-Value="_layoutEnabled" Label="Grouped switch" SupportingText="Shares the fieldset context" />
            </NTFormSectionView>

            <NTFormSectionView Heading="Inline alignment" Description="Radio groups and text inputs should share the same top edge when placed as inline siblings." MaxColumns="3">
                <NTFormFieldLayoutSpan Span="NTFormFieldSpan.Full">
                    <style>
                        .inline-alignment-demo {
                            font-size: 0;
                        }

                        .inline-alignment-demo > .nt-radio,
                        .inline-alignment-demo > .nt-input {
                            width: min(360px, calc(50% - 8px));
                            margin-inline-end: 16px;
                            margin-block-end: 16px;
                            font-size: 1rem;
                        }
                    </style>

                    <div class="inline-alignment-demo">
                        <NTInputRadioGroup TValue="string" @bind-Value="_inlineAlignmentChoice" Label="Delivery method" SupportingText="Inline with adjacent input" class="inline-alignment-field">
                            <NTInputRadio TValue="string" Value="@("email")" Label="Email" />
                            <NTInputRadio TValue="string" Value="@("sms")" Label="SMS" />
                        </NTInputRadioGroup>

                        <NTInputText @bind-Value="_inlineAlignmentName" Label="Recipient" SupportingText="Top edge should align with radio group" class="inline-alignment-field" />
                    </div>
                </NTFormFieldLayoutSpan>
            </NTFormSectionView>

            <NTFormFieldGridView MaxColumns="6" ColumnGap="12px" RowGap="12px">
                <NTFormFieldLayoutSpan Span="NTFormFieldSpan.Compact">
                    <NTInputText @bind-Value="_layoutStandaloneA" Label="Standalone A" />
                </NTFormFieldLayoutSpan>

                <NTFormFieldLayoutSpan Span="NTFormFieldSpan.OneQuarter">
                    <NTInputText @bind-Value="_layoutStandaloneB" Label="Standalone B" />
                </NTFormFieldLayoutSpan>

                <NTFormFieldLayoutSpan Span="NTFormFieldSpan.Half">
                    <NTInputText @bind-Value="_layoutStandaloneC" Label="Standalone C" />
                </NTFormFieldLayoutSpan>

                <NTFormFieldLayoutSpan Span="NTFormFieldSpan.Full">
                    <NTTextArea @bind-Value="_layoutStandaloneD" Label="Standalone full width" MinVisibleLines="2" />
                </NTFormFieldLayoutSpan>
            </NTFormFieldGridView>

            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <button type="submit">Submit</button>
                <button type="button" @onclick="ResetModel">Reset values</button>
                <span>@_submitMessage</span>
            </div>

            <pre style="margin:0;padding:12px;overflow:auto;background:var(--nt-color-surface-container);color:var(--nt-color-on-surface);">@Summary</pre>
        </div>
    </NTForm>
</section>

