@page "/fab-offsets"
@rendermode InteractiveAuto
@using NTComponents

<h1>FAB offset checks</h1>

<NTFabButton Icon="MaterialIcon.Add" AriaLabel="Upper right FAB" Placement="NTFabButtonPlacement.UpperRight" />
