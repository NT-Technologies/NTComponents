@page "/FabButtons"
@using NTComponents

@rendermode InteractiveAuto
<select @bind="Size">
	@foreach (var size in Enum.GetValues<NTSize>().Distinct()) {
		<option value="@size">@size</option>
	}
</select>
<label>
	<input type="checkbox" @bind="ShowText" />
	ShowText
</label>
<label>
	<input type="checkbox" @bind="Disabled" />
	Disabled
</label>

<NTDivider style="margin-top:36px;margin-bottom:36px;" />

<div style="display:flex;gap:16px;">
	<NTFabButton ButtonSize="@Size" Disabled="Disabled" Icon="MaterialIcon.CloudySnowing" Label="@(ShowText ? "First Button Text" : null)" ShowBadge="true" BadgeContent="100" />
	<NTFabButton ButtonSize="@Size" Disabled="Disabled" Icon="MaterialIcon.Radar" Label="@(ShowText ? "Second Button Text" : null)" ShowBadge="true" BadgeContent="100" />
	<NTFabButton ButtonSize="@Size" Disabled="Disabled" Icon="MaterialIcon.Blender" Label="@(ShowText ? "Third Button Text" : null)" ShowBadge="true" BadgeContent="100" />
</div>

@code {
	private NTSize Size { get; set; } = NTSize.Small;

	private bool Disabled { get; set; }

	private bool ShowText { get; set; } = true;
}
