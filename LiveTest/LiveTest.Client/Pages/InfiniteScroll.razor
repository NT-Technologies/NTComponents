@page "/InfiniteScroll"
@rendermode InteractiveAuto
@using NTComponents
@using NTComponents.Virtualization

<h3>InfiniteScroll</h3>

<NTVirtualize TItem="int" ItemsProvider="GetItems">

</NTVirtualize>


@code {
    async ValueTask<NTVirtualizeItemsProviderResult<int>> GetItems(NTVirtualizeItemsProviderRequest<int> request)
    {
        await Task.Delay(1000); // Simulate async loading
        return new NTVirtualizeItemsProviderResult<int>()
            {
                Items = Enumerable.Range(request.StartIndex, 50).ToList(),
                TotalItemCount = 1000
            };
    }
}
