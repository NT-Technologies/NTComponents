{
  "name": "ntcomponents-js-tests",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@material/material-color-utilities": "0.4.0",
    "@oddbird/css-anchor-positioning": "0.10.2",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "esbuild": "0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "semantic-release": "25.0.9",
    "terser": "^5.51.2",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build:head": "tsc -p tsconfig.head.json && node scripts/build-head-assets.mjs",
    "compile:ts": "tsc -p tsconfig.json && tsc -p tsconfig.legacy.json && tsc -p Submodules/NTComponents.Charts/tsconfig.json",
    "build:site": "tsc -p tsconfig.site.json && node scripts/build-site-assets.mjs",
    "build:site:release": "tsc -p tsconfig.site.json && node scripts/build-site-assets.mjs --minify",
    "build:ts": "npm run compile:ts && npm run build:site && npm run build:head",
    "build:ts:release": "npm run compile:ts && node scripts/minify-typescript.mjs && npm run build:site:release && npm run build:head",
    "pretest": "npm run build:ts && npm run test:release",
    "test:release": "node --test scripts/release-notes.test.mjs scripts/semantic-release.test.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:js": "npm run test"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/NTComponents",
      "<rootDir>/Tests/NTComponents.Tests/wwwroot"
    ],
    "setupFiles": [
      "<rootDir>/NTComponents/Carousel/jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/NTComponents/Editors/__tests__/jest.setup.js"
    ],
    "moduleFileExtensions": [
      "js",
      "mjs"
    ],
    "transform": {},
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/__tests__/**/*.spec.js",
      "**/Tests/NTComponents.Tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "jest.global.js",
      "jest.setup.js"
    ]
  }
}
